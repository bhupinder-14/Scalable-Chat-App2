NODE_ENV=development
PORT=3001
# Compose overrides these service URLs with its internal service names.
DB_URL=mongodb://127.0.0.1:27017/scalable_chat
REDIS_URL=redis://127.0.0.1:6379
KAFKA_BROKERS=127.0.0.1:9092
# Generate a unique local value of at least 32 characters before starting.
SESSION_SECRET=
# Comma-separated browser origins; Compose uses the same-origin local UI.
ALLOWED_ORIGINS=http://localhost:3001
